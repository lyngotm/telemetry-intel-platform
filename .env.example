# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry_user
POSTGRES_PASSWORD=telemetry_pass

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=telemetry.raw
KAFKA_TOPIC_ENRICHED=telemetry.enriched
KAFKA_TOPIC_DLQ=telemetry.dlq
KAFKA_PUBLISH_TIMEOUT_SECONDS=5.0

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Anomaly Detection
WINDOW_SIZE_SECONDS=300
MIN_WINDOW_SAMPLES=10
Z_SCORE_THRESHOLD_LOW=2.5
Z_SCORE_THRESHOLD_MEDIUM=3
Z_SCORE_THRESHOLD_HIGH=3.5
Z_SCORE_THRESHOLD_CRITICAL=4

# JWT Authentication
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ALGORITHM=RS256
JWT_EXPIRY_MINUTES=60

# Rate Limiting (requests per minute)
RATE_LIMIT_INGESTION=1000
RATE_LIMIT_QUERY=100

# Prometheus Metrics (consumer services)
METRICS_PORT_INGESTION=9090
METRICS_PORT_ANOMALY=9091

# ChromaDB (Vector Store)
CHROMA_HOST=localhost
CHROMA_PORT=8100

# AWS Model
EMBEDDING_PROVIDER=
CLAUDE_MODEL_ID=
CLAUDE_EMBEDDING_MODEL_ID=
AWS_REGION=

# Logging
LOG_LEVEL=INFO

