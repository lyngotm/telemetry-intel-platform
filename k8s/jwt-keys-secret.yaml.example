# k8s/jwt-keys-secret.yaml.example
# ============================================================
# JWT Keys Secret — TEMPLATE ONLY
# DO NOT commit real keys. Generate your own with:
#
#   kubectl create secret generic jwt-keys \
#     --from-file=private.pem=keys/private.pem \
#     --from-file=public.pem=keys/public.pem \
#     --namespace=tip
#
# Or use dry-run to generate the YAML file:
#
#   kubectl create secret generic jwt-keys \
#     --from-file=private.pem=keys/private.pem \
#     --from-file=public.pem=keys/public.pem \
#     --namespace=tip \
#     --dry-run=client -o yaml | kubectl apply -f -
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: jwt-keys
  namespace: tip
type: Opaque
data:
  # Base64-encoded PEM files (replace with your own)
  # Generate keys: openssl genrsa -out keys/private.pem 2048
  #                openssl rsa -in keys/private.pem -pubout -out keys/public.pem
  private.pem: <BASE64_ENCODED_PRIVATE_KEY>
  public.pem: <BASE64_ENCODED_PUBLIC_KEY>

